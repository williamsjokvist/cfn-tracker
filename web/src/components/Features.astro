---
import { Icon } from "astro-icon/components";
import MockTracker from "./MockTracker.astro";
import * as flagSvgs from "country-flag-icons/string/3x2";

import terminalTheme from "../../../app/pkg/server/static/themes/terminal.css?raw";
import comicTheme from "../../../app/pkg/server/static/themes/comic.css?raw";
import tickerTheme from "../../../app/pkg/server/static/themes/ticker.css?raw";
import stickerTheme from "../../../app/pkg/server/static/themes/sticker.css?raw";
import chipsTheme from "../../../app/pkg/server/static/themes/chips.css?raw";
import mostWantedStripTheme from "../../../app/pkg/server/static/themes/most-wanted-strip.css?raw";
import bannerTheme from "../../../app/pkg/server/static/themes/banner.css?raw";
import flashPortalTheme from "../../../app/pkg/server/static/themes/flash-portal.css?raw";
import linkTheme from "../../../app/pkg/server/static/themes/link.css?raw";
import blackoutTheme from "../../../app/pkg/server/static/themes/blackout.css?raw";
import zebraTheme from "../../../app/pkg/server/static/themes/zebra.css?raw";
import crimsonTheme from "../../../app/pkg/server/static/themes/crimson.css?raw";
import webcoreTheme from "../../../app/pkg/server/static/themes/webcore.css?raw";
import top8Theme from "../../../app/pkg/server/static/themes/top-8.css?raw";
import pivotTheme from "../../../app/pkg/server/static/themes/pivot.css?raw";
import velvetTheme from "../../../app/pkg/server/static/themes/velvet.css?raw";
import vaporTheme from "../../../app/pkg/server/static/themes/vapor.css?raw";
import ultraTheme from "../../../app/pkg/server/static/themes/ultra.css?raw";
import prowessTheme from "../../../app/pkg/server/static/themes/prowess.css?raw";

const mrHistory = [1482, 1501, 1494, 1530, 1521, 1548, 1539, 1566, 1581, 1573, 1592, 1604];
const chart = { width: 560, height: 80, pad: 6 };
const mrMin = Math.min(...mrHistory) - 10;
const mrMax = Math.max(...mrHistory) + 10;
const points = mrHistory.map((mr, i) => [
  chart.pad + (i * (chart.width - chart.pad * 2)) / (mrHistory.length - 1),
  chart.pad + ((mrMax - mr) * (chart.height - chart.pad * 2)) / (mrMax - mrMin),
]);
const linePath = points.map(([x, y], i) => `${i ? "L" : "M"}${x.toFixed(1)},${y.toFixed(1)}`).join(" ");
const areaPath = `${linePath} L${points[points.length - 1][0].toFixed(1)},${chart.height} L${points[0][0].toFixed(1)},${chart.height} Z`;

const recentSessions = [
  { date: "Sat 12 Oct", wins: 9, losses: 5, lpGain: 210, mrGain: 31 },
  { date: "Thu 10 Oct", wins: 6, losses: 7, lpGain: -40, mrGain: -8 },
];

const comparison = [
  { metric: "Drive Parry", you: 312, top: 498 },
  { metric: "Throw Tech", you: 22, top: 61 },
  { metric: "Punish Counter", you: 141, top: 187 },
  { metric: "Just Parry", you: 9, top: 34 },
  { metric: "Drive Impact", you: 58, top: 41 },
];

const csvRows = [
  ["date", "time", "character", "opponent", "opponent_character", "victory", "mr", "mr_gain"],
  ["2026-10-12", "21:42", "Ken", "bboylong", "Akuma", "true", "1604", "12"],
  ["2026-10-12", "21:38", "Ken", "dierto", "Chun-Li", "false", "1592", "-9"],
  ["2026-10-12", "21:25", "Ken", "indigoinconnu", "Zangief", "true", "1601", "11"],
  ["2026-10-12", "21:23", "Ken", "UchihaStrider", "Akuma", "true", "1590", "10"],
  ["2026-10-12", "21:08", "Ken", "ferret_ja", "Rashid", "false", "1580", "-8"],
  ["2026-10-12", "21:00", "Ken", "Ryu_Knight", "Ryu", "true", "1588", "9"],
];

// The app's own browser source themes, rendered against the same markup it serves to OBS.
const outputStats = [
  ["wins", "Wins", "4"],
  ["losses", "Losses", "2"],
  ["winRate", "Win Rate", "67%"],
  ["mr", "MR", "1604"],
  ["mrGain", "MR Gain", "+12"],
];
const statListHtml = `<dl class="stat-list">${outputStats
  .map(
    ([key, title, value]) =>
      `<div class="stat-item" data-stat="${key}"><dt class="stat-title">${title}</dt><dd class="stat-value">${value}</dd></div>`,
  )
  .join("")}</dl>`;
// Wide themes are scaled down to fit the preview rather than cut off. The list is measured
// again whenever it resizes, since fonts loading in and the language picker both change it.
const fitScript = `<script>
const list = document.querySelector(".stat-list");
new ResizeObserver(() => {
  const style = getComputedStyle(list);
  const width = list.offsetWidth + parseFloat(style.marginLeft) + parseFloat(style.marginRight);
  const height = list.offsetHeight + parseFloat(style.marginTop) + parseFloat(style.marginBottom);
  const scale = Math.min(1, (innerWidth - 48) / width, (innerHeight - 48) / height);
  list.style.transformOrigin = "top left";
  list.style.transform = scale < 1 ? \`scale(\${scale})\` : "";
}).observe(list);
<\/script>`;
const themes = [
  { id: "chips", name: "Chips", css: chipsTheme },
  { id: "velvet", name: "Velvet", css: velvetTheme },
  { id: "vapor", name: "Vapor", css: vaporTheme },
  { id: "zebra", name: "Zebra", css: zebraTheme },
  { id: "most-wanted-strip", name: "Most Wanted", css: mostWantedStripTheme },
  { id: "pivot", name: "Pivot", css: pivotTheme },
  { id: "flash-portal", name: "Flash Portal", css: flashPortalTheme },
  { id: "ultra", name: "Ultra", css: ultraTheme },
  { id: "prowess", name: "Prowess", css: prowessTheme },
  { id: "webcore", name: "Webcore", css: webcoreTheme },
  { id: "top-8", name: "Top 8", css: top8Theme },
  { id: "terminal", name: "Terminal", css: terminalTheme },
  { id: "banner", name: "Banner", css: bannerTheme },
  { id: "link", name: "Link", css: linkTheme },
  { id: "blackout", name: "Blackout", css: blackoutTheme },
  { id: "crimson", name: "Crimson", css: crimsonTheme },
  { id: "comic", name: "Comic", css: comicTheme },
  { id: "ticker", name: "Ticker", css: tickerTheme },
  { id: "sticker", name: "Sticker", css: stickerTheme },
].map((theme) => ({
  ...theme,
  srcdoc: `<!doctype html><html><head><style>*{margin:0}body{padding:24px;overflow:hidden}</style><style>${theme.css}</style></head><body>${statListHtml}${fitScript}</body></html>`,
}));
const browserSourceQuery = outputStats.map(([key]) => `&${key}=true`).join("");

const localeFiles = import.meta.glob<Record<string, string>>("../../../app/pkg/i18n/locales/*.json", {
  eager: true,
  import: "default",
});
// Named the way the app's own language picker names them, in each language's own words
const languages = Object.entries(localeFiles)
  .map(([path, strings]) => {
    const code = path.match(/([\w-]+)\.json$/)![1];
    const locale = new Intl.Locale(code).maximize();
    const sharesLanguage =
      Object.keys(localeFiles).filter((p) => p.includes(`/${locale.language}-`)).length > 1;
    const name = new Intl.DisplayNames([code], { type: "language", style: "narrow", fallback: "code" }).of(
      sharesLanguage ? `${locale.language}-${locale.script}` : locale.language,
    )!;
    return {
      code,
      name: name.charAt(0).toLocaleUpperCase(code) + name.slice(1),
      flag: (flagSvgs as Record<string, string>)[locale.region!],
      titles: Object.fromEntries(outputStats.map(([key, title]) => [key, strings[key] ?? title])),
    };
  })
  .sort((a, b) => a.name.localeCompare(b.name));
const defaultLanguage = languages.find((l) => l.code === "en-GB")!;
---

<script>
  document.addEventListener("astro:page-load", () => {
    const themePicker = document.getElementById("theme-picker");
    const themeButtons = [...(themePicker?.querySelectorAll<HTMLButtonElement>("button[data-theme]") ?? [])];
    const previews = document.querySelectorAll<HTMLIFrameElement>("#theme-previews iframe");

    const showTheme = (theme: string) => {
      for (const b of themeButtons) b.setAttribute("aria-pressed", String(b.dataset.theme === theme));
      for (const frame of previews) frame.classList.toggle("active", frame.dataset.theme === theme);
      const url = document.getElementById("browser-source-theme");
      if (url) url.textContent = theme;
    };

    // Cycles through the themes like a slideshow until someone picks one themselves. Skipped for
    // people who prefer reduced motion.
    let slideshow: ReturnType<typeof setInterval> | undefined;
    if (themeButtons.length > 1 && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      let current = 0;
      slideshow = setInterval(() => {
        current = (current + 1) % themeButtons.length;
        showTheme(themeButtons[current].dataset.theme!);
      }, 2500);
      document.addEventListener("astro:before-swap", () => clearInterval(slideshow), { once: true });
    }

    themePicker?.addEventListener("click", (e) => {
      const theme = (e.target as HTMLElement).closest<HTMLButtonElement>("button[data-theme]")?.dataset.theme;
      if (!theme) return;
      clearInterval(slideshow);
      showTheme(theme);
    });

    const languageSelect = document.getElementById("language-select");
    if (languageSelect) {
      const titles: Record<string, Record<string, string>> = JSON.parse(languageSelect.dataset.titles ?? "{}");
      const toggle = languageSelect.querySelector<HTMLButtonElement>("button[aria-haspopup]")!;
      const list = languageSelect.querySelector("ul")!;
      const frames = document.querySelectorAll<HTMLIFrameElement>("#theme-previews iframe");
      let lang = "en-GB";

      const setOpen = (open: boolean) => {
        list.hidden = !open;
        toggle.setAttribute("aria-expanded", String(open));
      };
      // The previews are srcdoc frames, so their documents can be relabelled in place
      const relabel = (frame: HTMLIFrameElement) => {
        const doc = frame.contentDocument;
        if (!doc?.body) return;
        doc.documentElement.lang = lang;
        for (const item of doc.querySelectorAll<HTMLElement>(".stat-item")) {
          const title = item.querySelector(".stat-title");
          if (title && item.dataset.stat) title.textContent = titles[lang][item.dataset.stat];
        }
      };

      // Frames load lazily, so ones that haven't loaded yet pick up the language when they do
      for (const frame of frames) frame.addEventListener("load", () => relabel(frame));
      toggle.addEventListener("click", () => setOpen(list.hidden));
      languageSelect.addEventListener("focusout", (e) => {
        if (!languageSelect.contains(e.relatedTarget as Node | null)) setOpen(false);
      });
      languageSelect.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          setOpen(false);
          toggle.focus();
        }
      });
      list.addEventListener("click", (e) => {
        const option = (e.target as HTMLElement).closest<HTMLButtonElement>("button[data-lang]");
        if (!option?.dataset.lang) return;
        lang = option.dataset.lang;
        for (const o of list.querySelectorAll("button[data-lang]")) {
          o.setAttribute("aria-selected", String(o === option));
        }
        toggle.querySelector(".flag")!.innerHTML = option.querySelector(".flag")!.innerHTML;
        const url = document.getElementById("browser-source-lang");
        if (url) url.textContent = lang;
        frames.forEach(relabel);
        setOpen(false);
        toggle.focus();
      });
    }
  });
</script>
<section
  id="features"
  class="[&>*:nth-child(even)]:flex-row-reverse flex flex-col gap-60 px-4"
>

  <section class="flex flex-wrap items-center justify-around">
    <header class="mb-8 max-w-[700px] w-full">
      <h2 class="font-bold text-3xl md:text-5xl">
        <Icon
          name="ion:stats-chart"
          class="inline text-[#f85961] w-12 h-12 mr-1"
        />
        Sessions & progress
      </h2>
      <p class="text-lg mt-8">
        Every match is logged into sessions, so you can look back at how each
        one went and watch your MR and LP climb over time. Break it down per
        character, or dig into the full match log with replay IDs
      </p>
    </header>
    <div class="tracker-container w-full md:w-auto overflow-auto md:overflow-visible">
      <MockTracker title="Statistics" page="stats">
        <div class="px-6 pt-3 whitespace-nowrap">
          <dl class="flex gap-2">
            <div class="flex flex-1 gap-3 justify-between bg-slate-50 bg-opacity-5 px-3 pt-2 pb-0.5 rounded-xl">
              <dt class="tracking-wider font-extralight text-sm">Sessions</dt>
              <dd class="text-2xl font-semibold">24</dd>
            </div>
            <div class="flex flex-1 gap-3 justify-between bg-slate-50 bg-opacity-5 px-3 pt-2 pb-0.5 rounded-xl">
              <dt class="tracking-wider font-extralight text-sm">Wins</dt>
              <dd class="text-2xl font-semibold">186</dd>
            </div>
            <div class="flex flex-1 gap-3 justify-between bg-slate-50 bg-opacity-5 px-3 pt-2 pb-0.5 rounded-xl">
              <dt class="tracking-wider font-extralight text-sm">Losses</dt>
              <dd class="text-2xl font-semibold">151</dd>
            </div>
            <div class="flex flex-1 gap-3 justify-between bg-slate-50 bg-opacity-5 px-3 pt-2 pb-0.5 rounded-xl">
              <dt class="tracking-wider font-extralight text-sm">Win Rate</dt>
              <dd class="text-2xl font-semibold">55%</dd>
            </div>
          </dl>

          <figure class="mt-2 bg-slate-50 bg-opacity-5 rounded-xl px-3 pt-2 pb-1">
            <figcaption class="flex justify-between text-sm tracking-wider font-extralight">
              <span>MR over time</span>
              <span class="font-semibold text-[#00ff4d]">+122</span>
            </figcaption>
            <svg
              viewBox={`0 0 ${chart.width} ${chart.height}`}
              class="w-full h-[64px]"
              preserveAspectRatio="none"
              role="img"
              aria-label="MR rising from 1482 to 1604 over the last 12 sessions"
            >
              <defs>
                <linearGradient id="mr-area" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="rgba(0, 255, 77, .35)" />
                  <stop offset="100%" stop-color="rgba(0, 255, 77, 0)" />
                </linearGradient>
              </defs>
              <path d={areaPath} fill="url(#mr-area)" />
              <path
                d={linePath}
                fill="none"
                stroke="rgba(0, 255, 77, .8)"
                stroke-width="2.5"
                stroke-linejoin="round"
                vector-effect="non-scaling-stroke"
              />
            </svg>
          </figure>

          <h3 class="mt-3 mb-1 text-sm uppercase tracking-widest">Recent sessions</h3>
          <ul class="flex flex-col gap-1">
            {
              recentSessions.map((session) => (
                <li class="flex justify-between gap-4 bg-slate-50 bg-opacity-5 rounded-xl px-3 py-1.5">
                  <span class="w-28">{session.date}</span>
                  <span>{`${session.wins} – ${session.losses}`}</span>
                  <span>{Math.round((session.wins / (session.wins + session.losses)) * 100)}%</span>
                  <span class={session.lpGain >= 0 ? "text-[#00ff4d]" : "text-[#fb4949]"}>
                    {`${session.lpGain >= 0 ? "+" : ""}${session.lpGain} LP`}
                  </span>
                  <span class={session.mrGain >= 0 ? "text-[#00ff4d]" : "text-[#fb4949]"}>
                    {`${session.mrGain >= 0 ? "+" : ""}${session.mrGain} MR`}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </MockTracker>
    </div>
  </section>

  <section class="flex flex-wrap items-center justify-around">
    <header class="mb-8 max-w-[700px] w-full">
      <h2 class="font-bold text-3xl md:text-5xl">
        <Icon
          name="mdi:trophy"
          class="inline text-[#f85961] w-12 h-12 mr-1"
        />
        Compare with top players
      </h2>
      <p class="text-lg mt-8">
        See how your Street Fighter 6 battle stats stack up against the top
        Master Rating players of your main character. Drive parries, punish
        counters, throw techs and dozens more, sorted by where you differ the
        most
      </p>
    </header>
    <div class="tracker-container w-full md:w-auto overflow-auto md:overflow-visible">
      <MockTracker title="Comparison · Gamer123" page="stats">
        <table class="mx-6 mt-2 w-[calc(100%-3rem)] border-spacing-y-1 border-separate whitespace-nowrap">
          <thead>
            <tr>
              <th class="text-left px-3">Metric</th>
              <th class="text-right px-3 w-[110px]">Gamer123</th>
              <th class="text-right px-3 w-[110px]">Top Avg</th>
              <th class="text-center px-3 w-[90px]">Δ</th>
            </tr>
          </thead>
          <tbody>
            {
              comparison.map((row) => (
                <tr>
                  <td class="rounded-l-xl bg-slate-50 bg-opacity-5 px-3 py-2">{row.metric}</td>
                  <td class="bg-slate-50 bg-opacity-5 px-3 py-2 text-right font-semibold">{row.you}</td>
                  <td class="bg-slate-50 bg-opacity-5 px-3 py-2 text-right">{row.top}</td>
                  <td
                    class="rounded-r-xl bg-slate-50 bg-opacity-5 px-3 py-2 text-center"
                    style={{ color: row.you >= row.top ? "#00ff4d" : "#fb4949" }}
                  >
                    {row.you >= row.top ? "▲" : "▼"} {Math.abs(row.you - row.top)}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </MockTracker>
    </div>
  </section>

  <section class="flex flex-wrap items-center justify-around">
    <header class="mb-8 max-w-[700px] w-full">
      <h2 class="font-bold text-3xl md:text-5xl">
        <Icon
          name="clarity:sign-out-solid"
          class="inline text-[#f85961] w-12 h-12 mr-1"
        />
        Stream overlay
      </h2>
      <p class="text-lg mt-8">
        Add your stats to OBS as a browser source. Pick the stats to show,
        choose one of the built-in themes or <a
          href="/theme-guide"
          class="underline">create your own with CSS</a
        >, and they update live after every match
      </p>
    </header>
    <div class="tracker-container w-full md:w-auto overflow-auto md:overflow-visible">
      <figure class="browser-source">
        <figcaption class="flex items-center gap-2 px-4 py-2 text-sm whitespace-nowrap overflow-hidden">
          <Icon name="mdi:broadcast" class="w-5 h-5 shrink-0 text-[#f85961]" />
          <span class="truncate">
            http://localhost:4242?theme=<b id="browser-source-theme">{themes[0].id}</b>&lang=<b id="browser-source-lang">{defaultLanguage.code}</b>{browserSourceQuery}
          </span>
        </figcaption>
        <div id="theme-previews">
          {
            themes.map((theme, i) => (
              <iframe
                data-theme={theme.id}
                title={`${theme.name} browser source theme`}
                srcdoc={theme.srcdoc}
                class:list={[{ active: i === 0 }]}
                loading="lazy"
                tabindex="-1"
              />
            ))
          }
        </div>
        <div class="flex items-start gap-2 px-4 py-3">
        <div id="theme-picker" class="flex flex-1 flex-wrap gap-2" role="group" aria-label="Theme">
          {
            themes.map((theme, i) => (
              <button
                type="button"
                data-theme={theme.id}
                aria-pressed={String(i === 0)}
                class="theme-button rounded-full px-4 py-1 text-sm"
              >
                {theme.name}
              </button>
            ))
          }
        </div>
        <div id="language-select" class="relative shrink-0" data-titles={JSON.stringify(Object.fromEntries(languages.map((l) => [l.code, l.titles])))}>
          <button
            type="button"
            aria-haspopup="listbox"
            aria-expanded="false"
            aria-label="Language"
            class="theme-button flex items-center gap-1 rounded-full px-3 py-1 text-sm"
          >
            <span class="flag" set:html={defaultLanguage.flag} />
            <Icon name="mdi:chevron-down" class="w-4 h-4" />
          </button>
          <ul
            role="listbox"
            aria-label="Language"
            hidden
            class="language-list absolute bottom-full right-0 mb-2 max-h-[300px] overflow-y-auto rounded-xl py-1 text-sm"
          >
            {
              languages.map((l) => (
                <li>
                  <button
                    type="button"
                    role="option"
                    data-lang={l.code}
                    aria-selected={String(l === defaultLanguage)}
                    class="flex w-full items-center gap-2 px-3 py-1 text-left whitespace-nowrap"
                  >
                    <span class="flag" set:html={l.flag} />
                    {l.name}
                  </button>
                </li>
              ))
            }
          </ul>
        </div>
        </div>
      </figure>
    </div>
  </section>

  <section class="flex flex-wrap items-center justify-around">
    <header class="mb-8 max-w-[700px] w-full">
      <h2 class="font-bold text-3xl md:text-5xl">
        <Icon
          name="mdi:file-export"
          class="inline text-[#f85961] w-12 h-12 mr-1"
        />
        Data export
      </h2>
      <p class="text-lg mt-8">
        Export your whole match history, or a comparison with the top players,
        to CSV and take it into a spreadsheet or your own tools <br /> You own
        your match logs, not Capcom or Bamco
      </p>
    </header>
    <div class="tracker-container w-full md:w-auto overflow-auto md:overflow-visible">
      <figure class="csv-window">
        <figcaption class="flex items-center gap-2 px-4 py-2 text-sm">
          <Icon name="mdi:file-delimited" class="w-5 h-5 text-[#00ff4d]" />
          Gamer123-matches.csv
        </figcaption>
        <table class="sheet">
          <thead>
            <tr>
              <th />
              {csvRows[0].map((_, i) => <th>{String.fromCharCode(65 + i)}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              csvRows.map((row, r) => (
                <tr class:list={{ "sheet-header": r === 0 }}>
                  <th>{r + 1}</th>
                  {row.map((cell) => (
                    <td class:list={{ numeric: /^-?\d+$/.test(cell) }}>
                      {cell === "true" || cell === "false" ? cell.toUpperCase() : cell}
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </figure>
    </div>
  </section>
</section>

<style lang="sass">

  #features>*:nth-child(even)
    .tracker-container::after
      --dot-color: #ff938e
      left: -28px

  #features>*:nth-child(odd)
    .tracker-container::after
      --dot-color: #43EE46
      left: 28px

  .tracker-container
    display: grid
    align-items: flex-end
    position: relative

  .tracker-container::after
    content: ''
    background: radial-gradient(var(--dot-color) 1px,transparent 1px)
    background-size: auto
    background-size: 10px 10px
    display: block
    height: 100%
    position: absolute
    width: 100%
    top: 28px
    z-index: -1
    border-radius: 24px

  .csv-window,
  .browser-source
    width: 700px
    border-radius: 12px
    overflow: hidden
    background: rgb(22 10 40)
    box-shadow: 0 2px 18px rgba(0,0,0,.25)

    figcaption
      background: rgba(255,255,255,.06)
      border-bottom: 1px solid rgba(255,255,255,.1)

  .sheet
    width: 100%
    border-collapse: collapse
    color: #e8e3f0
    font-family: Arial, Helvetica, sans-serif
    font-size: 12px
    white-space: nowrap

    th, td
      border: 1px solid rgba(255,255,255,.1)
      padding: 5px 8px
      text-align: left

    thead th, tbody th
      background: rgba(255,255,255,.06)
      color: rgba(255,255,255,.5)
